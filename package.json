{
  "name": "opencode-self-improvement",
  "version": "0.11.0",
  "description": "Durable memory for opencode: remember facts, decisions, and commands across sessions, plus a one-command per-repo setup (/repo-init).",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./tui": "./src/tui.tsx"
  },
  "module": "index.ts",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.0"
  },
  "author": "Alex Bogartz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abogartz/opencode-self-improvement.git"
  },
  "bugs": {
    "url": "https://github.com/abogartz/opencode-self-improvement/issues"
  },
  "homepage": "https://github.com/abogartz/opencode-self-improvement#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "memory",
    "ai-agent"
  ],
  "files": [
    "index.ts",
    "tui.ts",
    "tsconfig.json",
    "src",
    "command",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "codebase-memory-mcp": "0.11.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@opencode/plugin": "2.0.32",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@semantic-release/git": "11.0.1",
    "@types/bun": "1.4.2",
    "semantic-release": "25.0.9",
    "solid-js": "1.9.17",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "bun test ./test/",
    "test:e2e": "bun test ./e2e/ --timeout 240000",
    "gate": "bun scripts/merge-gate.ts",
    "gate:hooks": "git config core.hooksPath .githooks",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "bench": "bun bench/inject-cost.ts",
    "bench:recall": "bun bench/recall-quality.ts",
    "bench:write": "bun bench/write-latency.ts",
    "memory-view": "bun run src/viewer/server.ts",
    "lint": "biome lint"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
